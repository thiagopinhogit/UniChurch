# Environment Variables for AWS Lambda Deployment

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/unichurch?retryWrites=true&w=majority

# JWT Secret (generate a strong secret key)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Node Environment
NODE_ENV=production

# AWS Configuration (optional - can be set via AWS CLI)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1

